    {
      "id": "claude-code",
      "name": "Claude Code",
      "device": "keypad",
      "folder": "Console/Claude",
      "description": "Drive a Claude Code session: answer permission prompts, keep it moving, inspect what it did.",
      "buttons": [
        {
          "title": "Focus Claude",
          "glyph": "◉",
          "color": "#D97757",
          "steps": [
            {
              "key": "Tab",
              "mods": [
                "cmd"
              ]
            }
          ],
          "note": "Cmd+Tab jumps back to your previous app. Install the Claude Console plugin to upgrade this key into a real notification light that flashes when Claude needs you and focuses its window by name."
        },
        {
          "title": "Continue",
          "glyph": "⏎",
          "color": "#2D6A4F",
          "steps": [
            {
              "key": "Return"
            }
          ],
          "note": "Sends Return - accepts the highlighted choice or submits an empty prompt to let Claude carry on."
        },
        {
          "title": "Compact",
          "glyph": "≡",
          "color": "#186A6A",
          "steps": [
            {
              "text": "/compact"
            },
            {
              "key": "Return"
            }
          ],
          "note": "Summarises the conversation so far to free up context."
        },
        {
          "title": "Plan Mode",
          "glyph": "◳",
          "color": "#5B3FA8",
          "steps": [
            {
              "key": "Tab",
              "mods": [
                "shift"
              ]
            }
          ],
          "note": "Shift+Tab cycles permission modes: default, accept-edits, plan."
        },
        {
          "title": "Transcript",
          "glyph": "☷",
          "color": "#2A2E35",
          "steps": [
            {
              "key": "KeyO",
              "mods": [
                "ctrl"
              ]
            }
          ],
          "note": "Ctrl+O expands the full tool-call transcript."
        },
        {
          "title": "Rewind",
          "glyph": "↺",
          "color": "#2A2E35",
          "steps": [
            {
              "key": "Escape"
            },
            {
              "key": "Escape"
            }
          ],
          "note": "Double-Escape on an empty prompt opens the rewind/checkpoint menu."
        },
        {
          "title": "Deny",
          "glyph": "✕",
          "color": "#B3261E",
          "steps": [
            {
              "key": "Escape"
            }
          ],
          "note": "Escape declines the prompt. Works whatever shape the dialog takes, which the number keys do not."
        },
        {
          "title": "Always Allow",
          "glyph": "2",
          "color": "#B26A00",
          "steps": [
            {
              "key": "Key2"
            }
          ],
          "note": "Option 2 is 'Yes, and don't ask again'. Amber on purpose - this one grants standing permission."
        },
        {
          "title": "Allow Once",
          "glyph": "1",
          "color": "#1B7F3B",
          "steps": [
            {
              "key": "Key1"
            }
          ],
          "note": "Option 1 is 'Yes'. Approves this single call."
        }
      ]
    },
